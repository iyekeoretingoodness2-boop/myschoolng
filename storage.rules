rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function approved() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/academyMembers/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/academyMembers/$(request.auth.uid)).data.status == 'approved';
    }

    // Published lesson media is readable only by approved students/admins.
    match /courses/{allPaths=**} {
      allow read: if approved() || isAdmin();
      allow write: if isAdmin();
    }

    // Student project uploads are private to the owner and admins.
    match /submissions/{uid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024;
      allow update, delete: if isAdmin();
    }

    match /profileImages/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}